/* Description of a solution security policy. */

/* Assign the execute interface. */
execute: kl.core.Execute

/* Include the base.psl file containing a formal description of the Base security model. */
use nk.base._

/* Include EDL files. */
use EDL Einit
use EDL kl.core.Core
use EDL example.Hello

use kl.core.DCM._

{% if USE_DYNLD %}
use dynld._
{% endif %}

execute {
    /* Allows the KasperskyOS kernel to start itself and the Einit class process. */
    match src = kl.core.Core {
        match dst = kl.core.Core { grant () }
        match dst = Einit { grant () }
    }

    /* Allows the Einit class process to run specific processes. */
    match src = Einit {
        match dst = example.Hello { grant () }
        match dst = kl.core.DCM { grant () }
    }
}

request {
    /* Allows the KasperskyOS kernel to receive request
       from specific processes. */
    match dst = kl.core.Core {
        match src = Einit { grant () }
        match src = example.Hello { grant () }
    }

    /* Allows process with the kl.core.DCM class to receive request
       from the process with the example.Hello class. */
    match dst = kl.core.DCM {
        match src = example.Hello { grant () }
    }
}

/* Allows any task to send responses. */
response {
    grant()
}

/* Allows any task to return errors. */
error {
    grant()
}
