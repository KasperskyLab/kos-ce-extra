entities:

- name: mbim_ntpd.Client
  env:
    VFS_FILESYSTEM_BACKEND: client:kl.VfsNet
    VFS_NETWORK_BACKEND:    client:kl.VfsNet
@INIT_Client_ENTITY_ENV+@
  connections:
  - target: kl.VfsNet
    id:     kl.VfsNet
@INIT_Client_ENTITY_CONNECTIONS+@

- name: kl.Ntpd
  path: ntpd
  env:
    VFS_FILESYSTEM_BACKEND: client:kl.VfsNet
    VFS_NETWORK_BACKEND:    client:kl.VfsNet
@INIT_ntpd_ENTITY_ENV+@
  connections:
  - target: kl.VfsNet
    id:     kl.VfsNet
@INIT_ntpd_ENTITY_CONNECTIONS+@

@INIT_EXTERNAL_ENTITIES@
